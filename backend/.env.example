PORT=5000
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management
# Frontend URL(s) allowed to call the API (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# First admin account created by: npm run seed:admin
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345
